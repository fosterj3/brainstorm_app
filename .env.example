# Copy to .env. Never commit .env.
PORT=3000
# SQLite file location (keep under /data, which is gitignored). Leave unset to use data/ority.db,
# or data/brainstorm.db if that older file already exists.
# DB_PATH=data/ority.db
# Set to 1 when behind a hosting proxy (Fly, Render, etc.)
TRUST_PROXY=0
# Set to 1 to show a visible "Demo site" notice on every page (for free hosting where polls can be erased)
# DEMO_NOTICE=1
# The public address, used when the site is built (canonical links, sitemap, share images)
# SITE_URL=https://your.domain
# Storage adapter (sqlite is the only one built in)
# STORAGE=sqlite
# Keep polls across restarts by saving copies to a private S3-compatible bucket (for example Backblaze B2, which has
# a free plan). See docs/HOSTING.md. Set all four, or none. Run "npm run backup:check" to test them.
# BACKUP_S3_ENDPOINT=https://s3.us-west-004.backblazeb2.com
# BACKUP_S3_BUCKET=your-private-bucket
# BACKUP_S3_KEY_ID=
# BACKUP_S3_SECRET=
# Optional: where in the bucket copies go (default ority/), and how often to check for changes (default 60 seconds).
# Use a DIFFERENT prefix for anything you run on your own computer, so it never mixes with your live polls.
# BACKUP_PREFIX=ority/
# BACKUP_INTERVAL_SECONDS=60
