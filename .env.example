# Copy to .env and fill in. Never commit .env.
PORT=3000
# Passcode for the facilitator view. Required; use something unguessable (the placeholder is ignored)
FACILITATOR_PASSCODE=change-me
# SQLite file location (keep under /data, which is gitignored)
DB_PATH=data/brainstorm.db
# Development only: set to 1 to seed an empty database with the made-up sample ideas
SEED_EXAMPLE=0
# Set to 1 when behind a hosting proxy (Fly, Render, etc.)
TRUST_PROXY=0
